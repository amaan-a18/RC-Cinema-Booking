# Copy to .env and adjust. All vars are optional -- sane local-dev defaults
# are baked into app/config.py.

# Default: local SQLite file. For Postgres use e.g.:
# APP_DATABASE_URL=postgresql+psycopg2://rc:rc@localhost:5432/rc_cinemas
APP_DATABASE_URL=sqlite:///./rc_cinemas.db

APP_JWT_SECRET=dev-only-secret-change-me-in-production
APP_ACCESS_TOKEN_EXPIRE_MINUTES=720

APP_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
